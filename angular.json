{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "bun",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "hexakill": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "static"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/app/styles/shared-base.css",
              "src/app/styles/shared-components.css",
              "src/app/styles/shared-layout.css",
              "src/app/styles/welcome.css",
              "src/app/styles/character-select.css",
              "src/app/styles/route-map-core.css",
              "src/app/styles/route-map-compact.css",
              "src/app/styles/combat-shell.css",
              "src/app/styles/combatant-panels.css",
              "src/app/styles/combatant-info.css",
              "src/app/styles/combat-animations.css",
              "src/app/styles/combat-feedback.css",
              "src/app/styles/combat-banner.css",
              "src/app/styles/combat-actions.css",
              "src/app/styles/store.css",
              "src/app/styles/ending.css"
            ]
          },
          "configurations": {
            "production": {
              "optimization": {
                "styles": {
                  "inlineCritical": false
                }
              },
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "56kB",
                  "maximumError": "56kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "hexakill:build:production"
            },
            "development": {
              "buildTarget": "hexakill:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
