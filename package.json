{
  "name": "hexakill",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve:dist": "node tools/serve-static.mjs dist/hexakill/browser",
    "verify:preview": "node tools/verify-preview.mjs dist/hexakill/browser",
    "preview": "npm run build && npm run serve:dist",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:asset-geometry": "node tools/verify-asset-geometry.mjs",
    "inspect:assets": "node tools/inspect-assets.mjs",
    "verify:deployment": "node tools/verify-deployment.mjs",
    "verify:migration": "node tools/verify-migration.mjs",
    "verify:release": "node tools/verify-release.mjs",
    "verify:toolchain": "node tools/verify-toolchain.mjs",
    "simulate:balance": "node tools/run-balance-simulation.mjs",
    "simulate:full-run": "node tools/run-full-run-simulation.mjs",
    "verify:types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false src e2e tools playwright.config.ts angular.json package.json package-lock.json tsconfig.json tsconfig.app.json tsconfig.spec.json vercel.json biome.json",
    "lint": "biome lint src e2e tools playwright.config.ts --only=suspicious/noExplicitAny --only=correctness/noUnusedVariables --only=correctness/noUnusedImports --diagnostic-level=error",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && E2E_PRODUCTION=1 npm run test:e2e",
    "verify:docs": "node tools/verify-docs.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@lucide/angular": "^1.31.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
