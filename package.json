{
  "name": "hexakill",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "preview": "bun run build && bun run serve:dist",
    "serve:dist": "bun tools/serve-static.mjs dist/hexakill/browser",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:production": "bun run build && E2E_PRODUCTION=1 playwright test",
    "check": "biome ci .",
    "format": "biome format --write .",
    "verify:types": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.spec.json",
    "verify:assets": "bun tools/verify-assets.mjs",
    "simulate:full-run": "bun tools/simulate.ts"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@lucide/angular": "^1.31.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
