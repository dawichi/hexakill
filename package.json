{
  "name": "hexakill",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "serve:dist": "node tools/serve-static.mjs dist/hexakill/browser",
    "verify:preview": "node tools/verify-preview.mjs dist/hexakill/browser",
    "preview": "npm run build && npm run serve:dist",
    "verify:assets": "node tools/verify-assets.mjs",
    "verify:toolchain": "node tools/verify-toolchain.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format:check": "prettier --check 'src/**/*.{ts,html,css}' 'e2e/**/*.ts' 'tools/**/*.mjs' 'playwright.config.ts' '*.json' '*.md'",
    "test:e2e": "playwright test",
    "test:e2e:production": "npm run build && E2E_PRODUCTION=1 npm run test:e2e",
    "verify:docs": "node tools/verify-docs.mjs"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
